cc_library_static {
    name: "libinit_m30s",
    srcs: [
        "libinit_dalvik_heap.cpp",
        "libinit_utils.cpp",
    ],
    whole_static_libs: ["libbase"],
    export_include_dirs: ["include"],
    recovery_available: true,
}

cc_library_static {
    name: "init_m30s",
    srcs: ["init_m30s.cpp"],
    whole_static_libs: ["libinit_m30s"],
    include_dirs: ["system/core/init"],
    header_libs: ["libbase_headers"],
    recovery_available: true,
}
